// Firestoreセキュリティルールの雛形（lib/services/cloud_sync_service.dart用）。
//
// このファイルはリポジトリ内のドキュメントとして用意しているだけで、
// Firebase側へ自動デプロイはされない。実際に有効化するには、Firebase
// コンソールの Firestore Database > ルール タブへ貼り付けるか、
// Firebase CLIで `firebase deploy --only firestore:rules` を実行すること
// （事前に `firebase init firestore` でこのファイルをプロジェクトに
// 紐づける必要がある）。
//
// user_backups/{uid} には、その匿名認証ユーザー(uid)自身のローカル状態
// （登録アプリ一覧・プラン）のバックアップのみが保存される。他ユーザーの
// ドキュメントへは読み書きできないよう、認証済み本人のみに限定する。
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /user_backups/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 上記以外の全パスはデフォルトで拒否（Firestoreルールは明示的に
    // allowしない限り拒否がデフォルトのため、追加の記述は不要）。
  }
}
